generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MostStreamedSongs {
  id               Int       @id @default(autoincrement())
  name             String?
  artist           String?
  thumbnail        String?
  streamCount      BigInt?
  dailyStreamCount BigInt?
  year             String?
  genre            String?
  language         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([artist], map: "idx_most_streamed_songs_artist")
  @@index([genre], map: "idx_most_streamed_songs_genre")
  @@index([language], map: "idx_most_streamed_songs_language")
  @@index([name], map: "idx_most_streamed_songs_name")
  @@index([year], map: "idx_most_streamed_songs_year")
}

model MostStreamedAlbums {
  id               Int       @id @default(autoincrement())
  albName          String?
  artist           String?
  thumbnail        String?
  albType          String?
  streamCount      BigInt?
  dailyStreamCount BigInt?
  year             String?
  genre            String?
  language         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Station {
  id          String   @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Spotify playlist ID
  playlistId  String?
  
  // Relations
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  
  // Connections
  members     StationMember[]
  tracks      StationTrack[]
  
  @@index([ownerId])
}

model StationMember {
  id        String   @id @default(uuid())
  joinedAt  DateTime @default(now())
  
  // Relations  
  stationId String
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  
  @@unique([stationId, userId])
  @@index([stationId])
  @@index([userId])
}

model StationTrack {
  id        String   @id @default(uuid())
  trackId   String   // Spotify track ID
  addedAt   DateTime @default(now())
  
  // Track metadata for quick access
  name      String?
  artist    String?
  imageUrl  String?
  
  // Relations
  stationId String
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)
  
  addedById String
  addedBy   User    @relation(fields: [addedById], references: [id])
  
  @@index([stationId])
  @@index([addedById])
}

model User {
  id            String          @id @default(uuid())
  name          String?
  email         String?         @unique
  image         String?
  
  // OAuth related fields
  spotifyId     String?         @unique
  spotifyToken  String?
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  // Relations
  ownedStations Station[]
  memberships   StationMember[]
  addedTracks   StationTrack[]
}