generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MostStreamedSongs {
  id               Int      @id @default(autoincrement())
  name             String?
  artist           String?
  thumbnail        String?
  streamCount      BigInt?
  dailyStreamCount BigInt?
  year             String?
  genre            String?
  language         String?
  spotifyId        String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([artist], map: "idx_most_streamed_songs_artist")
  @@index([genre], map: "idx_most_streamed_songs_genre")
  @@index([language], map: "idx_most_streamed_songs_language")
  @@index([name], map: "idx_most_streamed_songs_name")
  @@index([year], map: "idx_most_streamed_songs_year")
  @@index([spotifyId], map: "idx_most_streamed_songs_spotify_id")
}

model MostStreamedAlbums {
  id               Int      @id @default(autoincrement())
  albName          String?
  artist           String?
  thumbnail        String?
  albType          String?
  streamCount      BigInt?
  dailyStreamCount BigInt?
  year             String?
  genre            String?
  language         String?
  spotifyId        String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([artist], map: "idx_most_streamed_albums_artist")
  @@index([genre], map: "idx_most_streamed_albums_genre")
  @@index([language], map: "idx_most_streamed_albums_language")
  @@index([albName], map: "idx_most_streamed_albums_name")
  @@index([year], map: "idx_most_streamed_albums_year")
  @@index([spotifyId], map: "idx_most_streamed_albums_spotify_id")
}

model Station {
  id               String          @id @default(uuid())
  name             String
  description      String?
  imageUrl         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  playlistId       String?
  isSystem         Boolean         @default(false)
  stationType      String?
  isPlaying        Boolean         @default(false)
  currentTrackId   String?
  currentSpotifyId String?
  playingStartedAt DateTime?
  playingUserId    String?
  lastActivityAt   DateTime?
  ownerId          String?
  owner            User?           @relation(fields: [ownerId], references: [id])
  playingUser      User?           @relation("StationPlayingUser", fields: [playingUserId], references: [id])
  members          StationMember[]
  tracks           StationTrack[]

  @@index([ownerId])
  @@index([isSystem])
  @@index([stationType])
  @@index([isPlaying])
  @@index([currentTrackId])
  @@index([playingUserId])
}

model StationMember {
  id        String   @id @default(uuid())
  joinedAt  DateTime @default(now())
  stationId String
  userId    String
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([stationId, userId])
  @@index([stationId])
  @@index([userId])
}

model StationTrack {
  id        String   @id @default(uuid())
  trackId   String
  addedAt   DateTime @default(now())
  name      String?
  artist    String?
  imageUrl  String?
  stationId String
  addedById String
  addedBy   User     @relation(fields: [addedById], references: [id])
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId])
  @@index([addedById])
}

model User {
  id              String                 @id @default(uuid())
  name            String?
  email           String?                @unique
  image           String?
  spotifyId       String?                @unique
  spotifyToken    String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  gameAttempts    DailySongGameAttempt[]
  ownedStations   Station[]
  playingStations Station[]              @relation("StationPlayingUser")
  memberships     StationMember[]
  addedTracks     StationTrack[]
}

model DailySongGame {
  id          String                 @id @default(uuid())
  date        DateTime
  songId      String
  songName    String
  artistName  String
  albumName   String?
  genre       String?
  releaseYear Int?
  popularity  Int?
  durationMs  Int?
  imageUrl    String?
  createdAt   DateTime               @default(now())
  isExplicit  Boolean?
  attempts    DailySongGameAttempt[]

  @@index([date])
}

model DailySongGameAttempt {
  id                 String        @id @default(uuid())
  gameId             String
  userId             String
  guessedSongId      String
  guessedSongName    String
  guessedArtistName  String
  guessedAlbumName   String?
  guessedGenre       String?
  guessedReleaseYear Int?
  guessedPopularity  Int?
  guessedDurationMs  Int?
  guessedImageUrl    String?
  attemptNumber      Int
  isCorrect          Boolean       @default(false)
  createdAt          DateTime      @default(now())
  guessedIsExplicit  Boolean?
  hintsUsed          String[]      @default([]) // Array of hint types used: ["thumbnail", "album", "artist"]
  game               DailySongGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id])

  @@unique([gameId, userId, attemptNumber])
  @@index([gameId])
  @@index([userId])
  @@index([createdAt])
}
