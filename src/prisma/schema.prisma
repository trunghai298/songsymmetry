generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MostStreamedSongs {
  id               Int     @id @default(autoincrement())
  name             String?
  artist           String?
  thumbnail        String?
  year             String?
  genre            String?
  language         String?
  streamCount      BigInt?
  dailyStreamCount BigInt?

  @@index([artist], map: "idx_most_streamed_songs_artist")
  @@index([genre], map: "idx_most_streamed_songs_genre")
  @@index([language], map: "idx_most_streamed_songs_language")
  @@index([name], map: "idx_most_streamed_songs_name")
  @@index([year], map: "idx_most_streamed_songs_year")
}

model MostStreamedAlbums {
  id               Int     @id @default(autoincrement())
  albName          String?
  artist           String?
  thumbnail        String?
  albType          String?
  streamCount      BigInt?
  dailyStreamCount BigInt?
  year             String?
  genre            String?
  language         String?
}
